{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Bede API gateway (REST API) - routes /integration/auth/generate-token and /integration/accounts/transaction-history. Protected routes are authorised by this environment's Cognito user pool, in bede-identity, using API Gateway's native Cognito authorizer. Deployed in each application account (dev, uat, prod).",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "AllowedValues": [
        "dev",
        "uat",
        "prod"
      ]
    },
    "CustomDomainName": {
      "Type": "String",
      "Description": "Hostname this API is served on, e.g. api.dev.bede.bh. Must be covered by the certificate."
    },
    "CertificateArn": {
      "Type": "String",
      "Description": "ACM certificate ARN for CustomDomainName. Must be ISSUED and in the same region as this stack."
    },
    "HostedZoneName": {
      "Type": "String",
      "Description": "Public Route 53 hosted zone the record is created in, WITH a trailing dot, e.g. dev.bede.bh."
    },
    "GenerateTokenFunctionArn": {
      "Type": "String",
      "Description": "From the Lambda stack outputs"
    },
    "TransactionHistoryFunctionArn": {
      "Type": "String",
      "Description": "From the Lambda stack outputs"
    },
    "UserPoolArn": {
      "Type": "String",
      "AllowedPattern": "^arn:aws:cognito-idp:[a-z0-9-]+:[0-9]{12}:userpool/[A-Za-z0-9_-]+$",
      "ConstraintDescription": "A Cognito user pool ARN, e.g. arn:aws:cognito-idp:eu-west-1:123456789012:userpool/eu-west-1_AbCdEf",
      "Description": "ARN of THIS environment's Cognito user pool, in bede-identity (a cross-account ARN). From the Cognito stack's UserPoolArn output. Each environment must use its own pool, so that a dev token is rejected by prod."
    },
    "ThrottleRateLimit": {
      "Type": "Number",
      "Default": 20,
      "Description": "Steady-state requests per second, all routes"
    },
    "ThrottleBurstLimit": {
      "Type": "Number",
      "Default": 40
    },
    "TokenRouteRateLimit": {
      "Type": "Number",
      "Default": 2,
      "Description": "The token route is unauthenticated, so it is throttled harder"
    },
    "TokenRouteBurstLimit": {
      "Type": "Number",
      "Default": 5
    },
    "EnableAccessLogging": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "REST API access logging requires a CloudWatch Logs role to be set once per account and region (API Gateway > Settings). If it is not set, creating the stage fails; set it, or deploy with false."
    },
    "LogRetentionDays": {
      "Type": "Number",
      "Default": 90
    }
  },
  "Conditions": {
    "LoggingEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnableAccessLogging"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "ApiLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/apigateway/bede-api-${Environment}"
        },
        "RetentionInDays": {
          "Ref": "LogRetentionDays"
        }
      }
    },
    "RestApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": {
          "Fn::Sub": "bede-api-${Environment}"
        },
        "Description": "Bede partner API",
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        }
      }
    },
    "IntegrationResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Fn::GetAtt": [
            "RestApi",
            "RootResourceId"
          ]
        },
        "PathPart": "integration"
      }
    },
    "AuthResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Ref": "IntegrationResource"
        },
        "PathPart": "auth"
      }
    },
    "GenerateTokenResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Ref": "AuthResource"
        },
        "PathPart": "generate-token"
      }
    },
    "AccountsResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Ref": "IntegrationResource"
        },
        "PathPart": "accounts"
      }
    },
    "TransactionHistoryResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Ref": "AccountsResource"
        },
        "PathPart": "transaction-history"
      }
    },
    "ApiAuthorizer": {
      "Type": "AWS::ApiGateway::Authorizer",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "Name": "bede-cognito-pool",
        "Type": "COGNITO_USER_POOLS",
        "IdentitySource": "method.request.header.Authorization",
        "ProviderARNs": [
          {
            "Ref": "UserPoolArn"
          }
        ]
      }
    },
    "GenerateTokenMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "GenerateTokenResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${GenerateTokenFunctionArn}/invocations"
          },
          "TimeoutInMillis": 15000
        }
      }
    },
    "TransactionHistoryMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Metadata": {
        "Note": "The scope below must equal the Cognito resource server's Identifier/ScopeName and be granted in each client's AllowedOAuthScopes. It is deliberately NOT a parameter: a Deployment is immutable, so changing a method has no live effect until the Deployment is renamed, and a parameter change cannot rename it."
      },
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "TransactionHistoryResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "COGNITO_USER_POOLS",
        "AuthorizerId": {
          "Ref": "ApiAuthorizer"
        },
        "AuthorizationScopes": [
          "accounts/transaction-history"
        ],
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/${TransactionHistoryFunctionArn}/invocations"
          },
          "TimeoutInMillis": 29000
        }
      }
    },
    "DeploymentV1": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": [
        "GenerateTokenMethod",
        "TransactionHistoryMethod"
      ],
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "Description": "v1"
      }
    },
    "Stage": {
      "Type": "AWS::ApiGateway::Stage",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "DeploymentId": {
          "Ref": "DeploymentV1"
        },
        "StageName": "live",
        "MethodSettings": [
          {
            "ResourcePath": "/*",
            "HttpMethod": "*",
            "ThrottlingRateLimit": {
              "Ref": "ThrottleRateLimit"
            },
            "ThrottlingBurstLimit": {
              "Ref": "ThrottleBurstLimit"
            }
          },
          {
            "ResourcePath": "/~1integration~1auth~1generate-token",
            "HttpMethod": "POST",
            "ThrottlingRateLimit": {
              "Ref": "TokenRouteRateLimit"
            },
            "ThrottlingBurstLimit": {
              "Ref": "TokenRouteBurstLimit"
            }
          }
        ],
        "AccessLogSetting": {
          "Fn::If": [
            "LoggingEnabled",
            {
              "DestinationArn": {
                "Fn::GetAtt": [
                  "ApiLogGroup",
                  "Arn"
                ]
              },
              "Format": "{\"requestId\": \"$context.requestId\", \"ip\": \"$context.identity.sourceIp\", \"requestTime\": \"$context.requestTime\", \"httpMethod\": \"$context.httpMethod\", \"path\": \"$context.path\", \"status\": \"$context.status\", \"clientId\": \"$context.authorizer.claims.client_id\", \"integrationError\": \"$context.integrationErrorMessage\", \"responseLatency\": \"$context.responseLatency\"}"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      }
    },
    "GenerateTokenPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "GenerateTokenFunctionArn"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${RestApi}/*/POST/integration/auth/generate-token"
        }
      }
    },
    "TransactionHistoryPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "TransactionHistoryFunctionArn"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceArn": {
          "Fn::Sub": "arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${RestApi}/*/POST/integration/accounts/transaction-history"
        }
      }
    },
    "ApiDomainName": {
      "Type": "AWS::ApiGateway::DomainName",
      "Properties": {
        "DomainName": {
          "Ref": "CustomDomainName"
        },
        "RegionalCertificateArn": {
          "Ref": "CertificateArn"
        },
        "EndpointConfiguration": {
          "Types": [
            "REGIONAL"
          ]
        },
        "SecurityPolicy": "TLS_1_2"
      }
    },
    "ApiBasePathMapping": {
      "Type": "AWS::ApiGateway::BasePathMapping",
      "Properties": {
        "DomainName": {
          "Ref": "ApiDomainName"
        },
        "RestApiId": {
          "Ref": "RestApi"
        },
        "Stage": {
          "Ref": "Stage"
        }
      }
    },
    "ApiDnsRecord": {
      "Type": "AWS::Route53::RecordSet",
      "Properties": {
        "HostedZoneName": {
          "Ref": "HostedZoneName"
        },
        "Name": {
          "Ref": "CustomDomainName"
        },
        "Type": "A",
        "AliasTarget": {
          "DNSName": {
            "Fn::GetAtt": [
              "ApiDomainName",
              "RegionalDomainName"
            ]
          },
          "HostedZoneId": {
            "Fn::GetAtt": [
              "ApiDomainName",
              "RegionalHostedZoneId"
            ]
          },
          "EvaluateTargetHealth": false
        }
      }
    }
  },
  "Outputs": {
    "ApiBaseUrl": {
      "Description": "Custom domain base URL",
      "Value": {
        "Fn::Sub": "https://${CustomDomainName}"
      }
    },
    "GenerateTokenUrl": {
      "Value": {
        "Fn::Sub": "https://${CustomDomainName}/integration/auth/generate-token"
      }
    },
    "TransactionHistoryUrl": {
      "Value": {
        "Fn::Sub": "https://${CustomDomainName}/integration/accounts/transaction-history"
      }
    },
    "DefaultExecuteApiUrl": {
      "Description": "The generated endpoint. Note the stage name in the path, unlike the custom domain.",
      "Value": {
        "Fn::Sub": "https://${RestApi}.execute-api.${AWS::Region}.amazonaws.com/live"
      }
    }
  }
}
